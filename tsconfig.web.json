{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@browser-demo": ["./src/renderer/src/browserDemo/browserDemoApi.ts"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/*.d.ts",
    "src/core/**/*",
    "src/shared/**/*"
  ]
}
